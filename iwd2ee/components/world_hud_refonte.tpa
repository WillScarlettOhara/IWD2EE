// =====================================================================================
// World HUD Refonte  -  PoE/BG2EE-style floating HUD (opt-in, DESIGNATED 103)
// =====================================================================================
// Portraits = 54x84 busts in a 6x1 row bottom-right (58x88 slots, _S -> _B resref
// redirect with _S fallback), action bar + command bar on the user-art block
// bottom-centre (IEEXBARB: statue holds the pause orb + party AI), combat log
// bottom-left with click-cyclable height (IEEXLOGB, ini-persisted).
//
// What this component does:
//   * COPIES the refonte-only 1x assets from bam/world_hud_refonte (the 83 54x84
//     *_B.BMP busts + NOPORTB.BMP, the bust-shaped silhouette for portrait-less
//     creatures -- same LANCZOS downscale of the engine's NOPORTLG that the busts are
//     cropped from, minus its baked 4px frame; the DLL prefers it over the engine's
//     square 42x42 NOPORTSM whenever the slot is taller than wide,
//     IEEXBARB/IEEXLOGB.BMP, IEEXLOG1/2/3.BMP (a COMPLETE log bezel per
//     height preset, interior texture-synthesised at its final size -- the DLL draws the
//     matching one as a single quad, so the enlarged log neither smears nor repeats nor
//     shows a splice line; IEEXLOGB stays as the 3-slice fallback),
//     IEEXNULB.BAM + IEEXRSZB.BAM -- the invisible click strip and the visible chevron
//     tab that together make the log's resize border, GCOMMBTN.BAM with the
//     appended icon cycles, the bare-icon USGBTNQL.BAM), mirroring the 2x layout
//     (bam/bam_2x_ui/world_hud_refonte). Without this component the stock quickloot
//     toggle art comes from initial/USGBTNQL.BAM as always and GCOMMBTN stays the
//     biffed stock. B3QKLOOT/B3QKLOOM.MOS remain core (the quickloot bar + the
//     "UI Borders" toggle exist without the refonte). NPC Core's portrait busts ship
//     with that component's own portrait files (bam_new_npcs).
//   * "Old Portrait Health" (BG-style red HP fill, the look the busts are designed
//     around) is seeded at RUNTIME by IEex_InstallPortraitGrid: if the ini key is
//     absent it writes 1 and pokes the loaded option (the engine caches [Game
//     Options] at boot) -- WritePrivateProfileString handles section insertion
//     cleanly, so no ini text-munging here. An explicit player 0 is respected.
//   * GUIW08 (800x600) is refused at runtime by the same installer (the layout is
//     authored for the 1024-wide GUIW10 CHU, which the engine's 2x tier doubles).
//   * OPENGL ONLY: the refonte draws through the DLL's GL HUD layer (content-rects
//     composite, blended buttons, MOS skip). The same runtime gate turns the refonte
//     off under the software renderer (m_bIs3dAccelerated, chitin+0x91C) -- the
//     renderer is a launch-time choice, so nothing can be gated at install time.
//
// 2x UI (DESIGNATED 99/101): SUPPORTED. When a 2x UI is installed this component overlays
// the 2x set (108x168 busts, 2x IEEXBARB/IEEXLOGB) after the 1x COPY below. The engine 2x
// tier doubles the slot geometry (IEex_InstallPortraitGrid reads the manager double flag at
// mgr+0xAA), the DLL de-doubles the 108x168 busts to native 2x (CResBitmap 0x77ECF0/0x77EF70)
// and forces bDoubleSize under g_hdUI (Export_RenderPortraitRect) -- so the one layout renders
// crisp at both tiers. Reverse install order handled in 2x_ui_resolution_gate.tpa.
// =====================================================================================

PRINT ~[World HUD Refonte] Turning the floating HUD on (portrait busts bottom-right, bars bottom-centre, log bottom-left).~
PRINT ~[World HUD Refonte] Requires the OpenGL renderer and a resolution of 1024x768 or higher; the stock HUD is kept otherwise (runtime check).~

// Refonte-only 1x art (see header).
COPY ~%mod_folder%/bam/world_hud_refonte~ ~override~

// 2x UI installed (forward order: a 2x UI variant already installed before this) -> overlay the 2x
// set. MUST land AFTER the 1x COPY above (identical resrefs; the 2x busts/bar/log overwrite their 1x
// counterparts). The reverse order (a 2x UI installed AFTER the refonte) is handled symmetrically in
// components/2x_ui_resolution_gate.tpa (mirrors its New-GUI 2x overlay).
ACTION_IF (MOD_IS_INSTALLED ~iwd2ee.tp2~ ~99~) OR (MOD_IS_INSTALLED ~iwd2ee.tp2~ ~101~) BEGIN
  PRINT ~[Floating HUD] 2x UI detected -- overlaying the 2x bust/bar/log set (108x168 busts, 2x block/log art).~
  COPY ~%mod_folder%/bam/bam_2x_ui/world_hud_refonte~ ~override~
END

ACTION_IF FILE_EXISTS ~override/IEex_Gui_State.lua~ BEGIN
  COPY_EXISTING ~override/IEex_Gui_State.lua~ ~override~
    // Flip ONLY the column-0 declaration (^ = line start). The same text appears
    // tab-indented in IEex_InstallPortraitGrid's runtime guard (disable-when-unmet);
    // an unanchored replace flipped that too, so the guard would ENABLE instead of
    // disable under the software renderer / a non-GUIW10 CHU.
    REPLACE_TEXTUALLY ~^IEex_PortraitGridEnabled = false~ ~IEex_PortraitGridEnabled = true~
  BUT_ONLY_IF_IT_CHANGES
END ELSE BEGIN
  WARN ~[World HUD Refonte] override/IEex_Gui_State.lua not found (install the IWD2EE core first) -- refonte NOT enabled.~
END
