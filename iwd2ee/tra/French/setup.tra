//TRA num 1-100
@0 = ~Noyau d'IWD2EE~
@1 = ~Remaniement des classes~
@2 = ~Restrictions d'alignement plus souples pour les classes~
@3 = ~Remaniement des sorts~
@4 = ~Dons de prédilection pour toutes les écoles de magie~
@5 = ~Remaniement des objets~
@6 = ~Remaniement des créatures (difficulté+)~
@7 = ~Meilleure progression du gain d'XP~
@8 = ~Niveaux de difficulté complètement rétablis : le ND des ennemis est toujours égal à leur niveau~
@9 = ~Niveaux de difficulté partiellement rétablis : le ND des ennemis est égal ou légèrement inférieur à leur niveau (recommandé).~
@10 = ~Alternative plus rapide aux quêtes de la Palissade~
@11 = ~Forteresse de la Horde plus rapide~
@12 = ~Temple de Glace plus rapide~
@13 = ~Village Itinérant plus rapide~
@14 = ~Monastère du Corbeau Noir plus rapide~
@15 = ~Ombre-Terre plus rapide~
@16 = ~Œil du Dragon plus rapide~
@17 = ~Main Tranchée plus rapide~
@18 = ~Plus de potions pour Oswald~
@19 = ~Ajouter plus de parchemins au jeu~
@20 = ~Résistances et immunités des créatures revues à la baisse~
@21 = ~Correction du son de la métamorphose (à installer uniquement si votre druide émet des sons étranges après la métamorphose ; sinon, inutile)~
@22 = ~Jets de sauvegarde des ennemis ajustés à un niveau normal~
@23 = ~Changer l'immunité aux coups critiques~
@24 = ~Mode Mort subite~
@25 = ~Meilleurs ennemis raciaux pour les rôdeurs~
@26 = ~Débloque tous les choix de couleur pour chaque race~
@27 = ~Option d'intimidation de Xuki~
@28 = ~Option non violente concernant Isair et Madae~
@29 = ~Raccourcir la série de quêtes de la boucle temporelle de l'Œil du Dragon à une seule bataille~
@30 = ~Soudoyer Limha~
@31 = ~Soudoyer Mirabel et Majrash~
@32 = ~Diplomatie avec Guthma~
@33 = ~Duper Harshom~
@34 = ~Intimider Torak~
@35 = ~Intimider le Géancéphale~
@36 = ~Duper Thorasskus~
@37 = ~Duper Thvara~
@38 = ~Composant principal des compagnons~
@39 = ~Améliorations cosmétiques de l'interface graphique et nouveaux écrans de chargement~
@40 = ~Champ de Bataille du Temple de Glace remanié~
@41 = ~Résistance mineure aux dégâts pour les armures et les boucliers~
@42 = ~Correction du script ChangeAIScript~
@43 = ~Remaniement des races~
@44 = ~Les ennemis donnent la même quantité d'expérience quel que soit le niveau du groupe~
@45 = ~Ajuster le niveau des rencontres (difficulté++)~
@46 = ~Toujours combattre au moins la version de niveau moyen d'une rencontre~
@47 = ~Toujours combattre la version de haut niveau d'une rencontre~
@48 = ~En mode Coeur de furie, reduire les bonus aux PV des creatures~
@49 = ~En mode Cœur de furie, supprimer les bonus aux valeurs de caractéristiques des créatures alliées invoquées~
@50 = ~Les ennemis donnent 25 * ND d'expérience, assez pour qu'un groupe de six personnages atteigne le niveau 15-16 à la fin du jeu~
@51 = ~Les ennemis donnent 35 * ND d'expérience, assez pour qu'un groupe de six personnages atteigne le niveau 18-19 à la fin du jeu~
@52 = ~En mode Coeur de furie, reduire les bonus a l'attaque des creatures~
@53 = ~En mode Coeur de furie, reduire les bonus aux jets de sauvegarde des creatures~
@54 = ~Les creatures en mode Coeur de furie subissent un malus de -3 a tous les jets de sauvegarde~
@55 = ~Les creatures en mode Coeur de furie qui ont normalement 10 Des de Vie ou moins subissent un malus de -3 a tous les jets de sauvegarde~
@56 = ~Les morts-vivants, les constructions, les objets, les élémentaires et les vases deviennent immunisés aux coups critiques ; toutes les autres créatures deviennent vulnérables aux coups critiques~
@57 = ~Toutes les créatures deviennent vulnérables aux coups critiques~
@58 = ~Les PNJ commencent avec de l'expérience en rejoignant le groupe~
@59 = ~En mode Cœur de furie, faire en sorte que le groupe commence le jeu avec plus d'expérience~
@60 = ~Commencer avec un total de 36 000 points d'experience repartis entre les membres du groupe, assez pour qu'un groupe de six personnages commence au niveau 4 (recommande si vous avez installe certains des composants qui affaiblissent les creatures du mode Coeur de furie)~
@61 = ~Commencer avec un total de 90 000 points d'experience repartis entre les membres du groupe, assez pour qu'un groupe de six personnages commence au niveau 6~
@62 = ~Commencer avec un total de 270 000 points d'expérience répartis entre les membres du groupe, assez pour qu'un groupe de six personnages commence au niveau 10~
@63 = ~Réduire le délai entre chaque attaque sournoise~
@64 = ~Revoir les écoles opposées pour les magiciens spécialistes~
@65 = ~Le supprimer~
@66 = ~Le réduire à 1 round~
@67 = ~Thème principal en boucle~
@68 = ~Les PNJ commencent avec l'expérience moyenne du reste du groupe~
@69 = ~Les PNJ commencent avec un cinquième de l'expérience totale du reste du groupe (ainsi, l'XP de départ des PNJ ne dépendra pas de la taille du groupe)~
@70 = ~Ajuster le niveau maximum~
@71 = ~L'augmenter à 40~
@72 = ~L'augmenter à 50~
@73 = ~Permettre aux aasimars, tieffelins, drows, duergars et svirfnebelins de monter en niveau aussi vite que les autres races (pas d'ajustement de niveau) mais les affaiblir au niveau de puissance des autres races~
@74 = ~Revoir les différences de gain d'XP des races~
@75 = ~Toujours apprendre avec succès les sorts provenant de parchemins~
@76 = ~Chaque membre du groupe commence le mode Coeur de furie avec 28 000 points d'experience, assez pour atteindre le niveau 8~
@77 = ~Chaque membre du groupe commence le mode Coeur de furie avec 78 000 points d'experience, assez pour atteindre le niveau 13 (recommande)~
@78 = ~Chaque membre du groupe commence le mode Cœur de furie avec 28 000 points d'expérience, assez pour atteindre le niveau 8 (recommandé)~
@79 = ~Chaque membre du groupe commence le mode Cœur de furie avec 45 000 points d'expérience, assez pour atteindre le niveau 10~
@80 = ~Chaque membre du groupe commence le mode Cœur de furie avec 78 000 points d'expérience, assez pour atteindre le niveau 13~
@81 = ~Supprimer la limite d'invocation~
@82 = ~Ajouter les attaques d'opportunité au jeu~
@83 = ~Seuls les personnages ayant un certain don peuvent effectuer des attaques d'opportunité~
@84 = ~Tout le monde peut effectuer des attaques d'opportunité~
@85 = ~Changer la façon dont les valeurs de caractéristiques sont attribuées à la création du personnage~
@86 = ~Lancer les dés pour les caractéristiques - Les boutons Plus/Moins sont désactivés, mais vous pouvez choisir à quelle valeur de caractéristique chaque nombre tiré correspond (comme dans Le Temple du Mal Élémentaire)~
@87 = ~Lancer les dés pour les caractéristiques - Boutons Plus/Moins activés (comme dans Baldur's Gate)~
@88 = ~Ajout de nombreux objets à chaque zone du jeu ; cela pourrait prendre un certain temps...~
@89 = ~Ajouter plus de pièges~
@90 = ~Ajouter des raccourcis clavier pour automatiser l'application de buffs (voir le fichier ReadMe pour plus d'informations)~
@91 = ~Plus d'options de persuasion~
@92 = ~Ajouter des façons de progresser à travers certaines zones~
@93 = ~Achat de points - Augmenter une valeur de caractéristique au-delà d'une certaine valeur nécessite des points supplémentaires, et elle ne peut pas être inférieure à 8 (comme dans Neverwinter Nights)~
@98 = ~Vous devez d'abord installer le noyau d'IWD2EE.~
@99 = ~Le Widescreen Mod n'est pas compatible avec IWD2EE et fera planter le jeu s'il est aussi installé. Veuillez le désinstaller. IWD2EE vous permet déjà d'augmenter la résolution du jeu ; vous n'avez pas besoin du Widescreen Mod.~
@100 = ~IWD2EE n'a pas été désinstallé correctement ; les fichiers de l'installation précédente sont toujours dans le dossier override.
Installer IWD2EE une nouvelle fois sans supprimer ces fichiers pourrait corrompre divers fichiers.
Pour installer IWD2EE, procédez comme suit :
1. Désinstallez tous vos autres mods.
2. Ensuite, allez dans le dossier « override » et supprimez tout ce qu'il contient.
3. Réinstallez vos mods, y compris IWD2EE.~

